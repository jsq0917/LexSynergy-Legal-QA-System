# ---- 服务 ----
API_PORT=8201
STATUTE_PORT=5101
CALC_PORT=5102
COMPLIANCE_PORT=5103
VERIFIER_PORT=5104

# inproc = 进程内直调（测试/单机）；a2a = 真实 HTTP A2A（多服务/演示）
AGENT_TRANSPORT=inproc

# ---- 预算（三道闸）----
MAX_STEPS=8
MAX_LOOP=1
DEADLINE_S=25
STEP_TIMEOUT_S=20

# ---- 编排 ----
# auto=按风险升级（默认，推荐）| fast=强制快速通道 | full=强制全编排
ROUTING_POLICY=auto

# ---- 检索 ----
# dense=稠密(bge-m3，R@5 最高) | hybrid=稠密+BM25 加权 RRF(R@8 最高) | bm25=零依赖基线
RETRIEVAL_BACKEND=dense
RETRIEVAL_TOPK=5
# bge-m3 权重目录（默认指向 HF 缓存里已下载的那份）
EMBEDDING_MODEL_PATH=
EVIDENCE_BUDGET_CHARS=6000

# ---- 阿里云百炼（DashScope，OpenAI 兼容模式）----
# 文本生成统一 deepseek-v4.1-flash；端点不要带尾斜杠
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_MODEL_FAST=
LLM_API_KEY=
# 必须关掉思考模式：否则 deepseek-v4.1-flash 会把 max_tokens 全花在 reasoning 上、content 返回空
LLM_ENABLE_THINKING=false
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# 关闭则只跑 4 道确定性闸（G1/G2/G3/G5），G4 会标为 skipped
VERIFY_SUPPORT_CHECK=true
VERIFY_NUMERIC_TOLERANCE=0.01

LOG_LEVEL=INFO
